{
  "name": "next-liquid-blog",
  "version": "1.0.0",
  "description": "A static Next.js blog for technical notes, reading-focused essays, and GitHub Pages publishing.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whiskeyi/next-liquid-blog.git"
  },
  "scripts": {
    "new:post": "node scripts/create-post.mjs",
    "sync:post-assets": "node scripts/sync-post-assets.mjs",
    "dev": "node scripts/sync-post-assets.mjs && next dev",
    "build": "node scripts/sync-post-assets.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.7.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp"
    ]
  }
}
